class_name Level
extends RefCounted
## Level loader from JSON (generated by tools/gen_pavlov_yar.py). Units are metres.
## Buildings are oriented rectangles: [cx, cy, w, d, height, kind, angle_deg].

var name := ""
var size := Vector2(100, 100)
var spawn := Vector2(10, 10)
var buildings: Array = []            # {poly, center, w, d, h, kind, key, box}
var walls: Array[PackedVector2Array] = []   # collision footprints
var water: Array[PackedVector2Array] = []
var walkable: Array[PackedVector2Array] = []  # bridges: walkable over water
var parks: Array[PackedVector2Array] = []
var roads: Array = []                # {type, w, pts, polys}
var streets: Array = []              # {w, pts, polys}
var bridges: Array = []              # {w, pts, polys}
var railways: Array = []
var blockposts: Array = []           # {id, pos, dir}


static func _pts(arr: Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for p in arr:
		out.append(Vector2(p[0], p[1]))
	return out


static func _lane(pts: PackedVector2Array, w: float) -> Array:
	return Geometry2D.offset_polyline(pts, w * 0.5, Geometry2D.JOIN_ROUND, Geometry2D.END_ROUND)


static func footprint(cx: float, cy: float, w: float, d: float, angle_deg: float) -> PackedVector2Array:
	var a := deg_to_rad(angle_deg)
	var u := Vector2(cos(a), sin(a))
	var v := Vector2(-u.y, u.x)
	var c := Vector2(cx, cy)
	return PackedVector2Array([c - u * w / 2 - v * d / 2, c + u * w / 2 - v * d / 2,
		c + u * w / 2 + v * d / 2, c - u * w / 2 + v * d / 2])


static func load_from(path: String) -> Level:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_error("Cannot open level: " + path)
		return null
	var data = JSON.parse_string(f.get_as_text())
	if typeof(data) != TYPE_DICTIONARY:
		push_error("Broken level JSON: " + path)
		return null
	var lv := Level.new()
	lv.name = data.get("name", "")
	lv.size = Vector2(data.size[0], data.size[1])
	lv.spawn = Vector2(data.spawn[0], data.spawn[1])
	for b in data.get("buildings", []):
		var poly := footprint(b[0], b[1], b[2], b[3], b[6])
		var min_x := INF
		var max_x := -INF
		var min_y := INF
		var max_y := -INF
		for p in poly:
			var s := Iso.to_screen(p)
			min_x = minf(min_x, s.x)
			max_x = maxf(max_x, s.x)
			min_y = minf(min_y, s.y)
			max_y = maxf(max_y, s.y)
		var h := float(b[4])
		lv.buildings.append({"poly": poly, "center": Vector2(b[0], b[1]), "w": float(b[2]), "d": float(b[3]),
			"h": h, "kind": b[5], "angle": float(b[6]), "key": b[0] + b[1],
			"box": Rect2(min_x, min_y - h * Iso.PX_PER_M_HEIGHT, max_x - min_x, max_y - min_y + h * Iso.PX_PER_M_HEIGHT)})
		lv.walls.append(poly)
	for w in data.get("water", []):
		lv.water.append(_pts(w))
	for pk in data.get("parks", []):
		lv.parks.append(_pts(pk))
	for r in data.get("roads", []):
		var pts := _pts(r.pts)
		lv.roads.append({"type": r.type, "w": float(r.w), "pts": pts, "polys": _lane(pts, r.w)})
	for s in data.get("streets", []):
		var pts := _pts(s.pts)
		lv.streets.append({"w": float(s.w), "pts": pts, "polys": _lane(pts, s.w)})
	for br in data.get("bridges", []):
		var pts := _pts(br.pts)
		var polys := Geometry2D.offset_polyline(pts, br.w * 0.5)
		lv.bridges.append({"w": float(br.w), "pts": pts, "polys": polys})
		for pl in polys:
			lv.walkable.append(pl)
	for rw in data.get("railways", []):
		lv.railways.append(_pts(rw))
	for bp in data.get("blockposts", []):
		lv.blockposts.append({"id": bp.id, "pos": Vector2(bp.pos[0], bp.pos[1]), "dir": Vector2(bp.dir[0], bp.dir[1])})
	return lv
